   doesn't affect the large upload-zone icon which Gradio already colors. */
.gradio-container [class*="audio"] button svg path,
.gradio-container [class*="Audio"] button svg path,
.gradio-container .gr-audio button svg path,
.gradio-container [class*="audio"] button svg circle,
