    box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.15), 0 2px 8px rgba(0,0,0,0.4);
    margin-top: -6px;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.gradio-container input[type="range"]::-webkit-slider-thumb:hover {
    transform: scale(1.15);
    box-shadow: 0 0 0 6px rgba(139, 92, 246, 0.22), 0 4px 12px rgba(0,0,0,0.5);
}
.gradio-container input[type="range"]::-moz-range-thumb {
    width: 16px; height: 16px;
    border-radius: 50%;
    background: white;
    border: 2px solid var(--accent-2);
    box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.15);
    cursor: pointer;
}

/* Checkbox & Radio */
.gradio-container input[type="checkbox"],
.gradio-container input[type="radio"] {
    accent-color: var(--accent-2) !important;
    width: 16px; height: 16px;
}
.gradio-container .gr-radio label,
.gradio-container .gr-checkbox label {
    padding: 8px 14px !important;
    border: 1px solid var(--border-default) !important;
    border-radius: var(--radius-sm) !important;
    background: rgba(255, 255, 255, 0.02) !important;
    margin-right: 8px !important;
    transition: all 0.15s ease;
}
.gradio-container .gr-radio label:has(input:checked),
.gradio-container .gr-checkbox label:has(input:checked) {
    border-color: rgba(139, 92, 246, 0.6) !important;
    background: var(--accent-grad-soft) !important;
    color: var(--text-primary) !important;
}

/* Audio component — keep wrapper dark, but DO NOT touch button shape or
   background (that breaks the drop-zone and hides native icons). Only
   force icon stroke/fill to be light so they stay visible on dark bg. */
.gradio-container .gr-audio {
    background: var(--bg-input) !important;
    border-radius: var(--radius-md) !important;
}

/* Icon visibility: raise contrast on the PATHS inside audio-player icons.
