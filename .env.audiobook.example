# OpenAI-compatible LLM
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
VOICEBOOK_PREPROCESS_MODEL=gpt-5.6-luna

# Local folders
VOICEBOOK_DATA_ROOT=../projects
